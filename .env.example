# Optional allow-listed analytics collector. Leave blank to disable analytics.
VITE_ANALYTICS_ENDPOINT=

# Optional support page, such as Ko-fi.
VITE_SUPPORT_URL=

# Optional, privacy-reviewed SaaS access-interest destination. Configure all three
# values together; the public app otherwise stays an analysis-only demo.
VITE_ACCESS_INTEREST_URL=
VITE_ACCESS_INTEREST_PRIVACY_URL=
VITE_ACCESS_INTEREST_OWNER=

# Optional disclosed affiliate URL template. {card} is URL-encoded at runtime.
VITE_TCGPLAYER_AFFILIATE_URL=
