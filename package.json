{
  "name": "colorbreak",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && node tools/run-root-mjs-tests.mjs",
    "test:node": "node tools/run-root-mjs-tests.mjs",
    "test:deploy-path": "node --test test/deploy-path-smoke.test.mjs",
    "check:shared-imports": "node --test test/shared-module-boundary.test.mjs",
    "test:watch": "vitest",
    "data:coverage": "node tools/report-coverage.mjs",
    "data:diff": "node tools/source-diff.mjs",
    "data:prices": "node tools/build-price-snapshot.mjs",
    "data:sealed-prices": "node tools/build-sealed-price-snapshot.mjs",
    "data:release-manifest": "node tools/build-release.mjs",
    "check:release-assets": "node tools/scan-release-assets.mjs dist",
    "check:data": "node tools/report-coverage.mjs --check",
    "check:prices": "node tools/build-price-snapshot.mjs --check",
    "check:decision-freshness": "node tools/build-price-snapshot.mjs --check --max-age-ms 21600000",
    "check:ready-examples": "node tools/check-ready-examples.mjs",
    "check:sealed-prices": "node tools/build-sealed-price-snapshot.mjs --check",
    "check": "npm run check:shared-imports && npm run test && npm run check:data && npm run check:prices && npm run check:sealed-prices && npm run check:ready-examples && npm run build && npm run test:deploy-path"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
